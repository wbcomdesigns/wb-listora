msgid "Core plugin settings — listings per page, slugs, currency."
msgstr "Główne ustawienia wtyczki — ogłoszenia na stronę, adresy URL, waluta."

#: includes/admin/class-settings-page.php:307
msgid ""
"Enable or disable individual features. Disabled features are completely "
"removed from the frontend."
msgstr ""
"Włącz lub wyłącz poszczególne funkcje. Wyłączone funkcje są całkowicie "
"usuwane z frontend'u."

#: includes/admin/class-settings-page.php:310
msgid "Maps"
msgstr "Mapy"

#: includes/admin/class-settings-page.php:312
msgid "Map provider, default coordinates, and clustering."
msgstr "Dostawca mapy, domyślne współrzędne i klastrowanie."

#: includes/admin/class-settings-page.php:315
msgid "Submissions"
msgstr "Zgłoszenia"

#: includes/admin/class-settings-page.php:317
msgid "Frontend submission and moderation settings."
msgstr "Ustawienia zgłoszeń frontend'u i moderacji."

#: includes/admin/class-settings-page.php:322
msgid "Review moderation, requirements, and owner reply settings."
msgstr "Ustawienia moderacji recenzji, wymagań i odpowiedzi właściciela."

#: includes/admin/class-settings-page.php:330
#: templates/blocks/user-dashboard/nav.php:93
msgid "Credits"
msgstr "Kredyty"

#: includes/admin/class-settings-page.php:332
msgid "Credit costs, listing limits, and payment integrations."
msgstr "Koszty kredytów, limity ogłoszeń i integracje płatności."

#: includes/admin/class-settings-page.php:335
