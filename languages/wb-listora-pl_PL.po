msgstr "Postęp importu CSV"

#: includes/admin/class-settings-page.php:2785
msgid "WP-CLI"
msgstr "WP-CLI"

#: includes/admin/class-settings-page.php:2786
msgid "Prefer the command line? Equivalent commands available via WP-CLI."
msgstr "Wolisz wiersz poleceń? Równoważne polecenia dostępne poprzez WP-CLI."

#: includes/admin/class-settings-page.php:2791
msgid "Show commands"
msgstr "Pokaż polecenia"

#: includes/admin/class-settings-page.php:2818
msgid "Migration Sources"
msgstr "Źródła migracji"

#: includes/admin/class-settings-page.php:2819
msgid ""
"Detect data from other directory plugins and import it into WB Listora. Run "
"a dry-run first to preview results."
msgstr ""
"Wykryj dane z innych wtyczek Directory i zaimportuj je do WB Listora. "
"Najpierw uruchom wersję testową, aby wyświetlić podgląd wyników."

#: includes/admin/class-settings-page.php:2824
msgid ""
"No migration sources are available. Install and activate a supported source "
