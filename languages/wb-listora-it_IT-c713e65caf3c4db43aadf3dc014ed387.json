ifica campo"],"field":["campo"],"Delete field":["Elimina campo"],"Delete field?":["Eliminare il campo?"],"Existing data in this field will remain in the database but will no longer be shown.":["I dati esistenti in questo campo resteranno nel database ma non verranno pi\u00f9 mostrati."],"Key":["Chiave"],"Label":["Etichetta"],"Searchable":["Ricercabile"],"Filterable":["Filtrabile"],"Show on Card":["Mostra nella scheda"],"Show in API":["Mostra nell'API"],"Hidden from the API because the field is hidden on the listing page.":["Nascosto dall'API perch\u00e9 il campo \u00e8 nascosto nella pagina dell'annuncio."],"Show on listing page":["Mostra nella pagina dell'annuncio"],"Show as money (site currency)":["Mostra come denaro (valuta del sito)"],"Schema.org property":["Propriet\u00e0 Schema.org"],"Placeholder":["Segnaposto"],"Help text":["Testo di aiuto"],"Add Option":["Aggiungi opzione"],"Group name...":["Nome del gruppo..."],"Add Group":["Aggiungi gruppo"],"Please enter a type name.":["Inserisci un nome per il tipo."],"Type saved successfully.":["Tipo salvato correttamente."],"Error saving type.":["Errore nel salvataggio del tipo."],"Network is slow \u2014 please try again.":["La connessione \u00e8 lenta \u2014 riprova."]}}}