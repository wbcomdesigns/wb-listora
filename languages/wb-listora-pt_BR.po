#: blocks/listing-calendar/block.json
msgctxt "block description"
msgid "Month calendar view showing event listings by date."
msgstr "Visualização do calendário do mês mostrando anúncios de eventos por data."

#: blocks/listing-card/block.json
msgctxt "block description"
msgid ""
"Displays a single listing as a card with image, rating, meta fields, and "
"favorite button."
msgstr ""
"Exibe um anúncio único como um card com imagem, classificação, campos de "
"metadados e botão de favorito."

#: blocks/listing-categories/block.json
msgctxt "block description"
msgid "Display listing categories in a grid with icons and listing counts."
msgstr "Exibe categorias de anúncios em uma grade com ícones e contagem de anúncios."

#: blocks/listing-detail/block.json
msgctxt "block description"
msgid ""
"Displays full listing details with gallery, tabs, contact info, business "
"hours, and reviews."
msgstr ""
"Exibe detalhes completos do anúncio com galeria, abas, informações de "
"contato, horários de funcionamento e avaliações."

#: blocks/listing-featured/block.json
msgctxt "block description"
msgid "Display featured or top-rated listings in a horizontal carousel."
msgstr ""
"Exibe anúncios em destaque ou melhor classificados em um carrossel "
"horizontal."

#: blocks/listing-grid/block.json
msgctxt "block description"
msgid ""
"Displays listing search results in a responsive grid, list, or split view "
"with pagination."
msgstr ""
"Exibe resultados de busca de anúncios em uma grade responsiva, lista ou "
"visualização dividida com paginação."

#: blocks/listing-map/block.json
msgctxt "block description"
msgid ""
"Interactive map showing listing locations with markers, clustering, and "
"search integration."
msgstr ""
"Mapa interativo mostrando localizações de anúncios com marcadores, "
"agrupamento e integração de busca."

#: blocks/listing-reviews/block.json
msgctxt "block description"
msgid ""
"Displays reviews with rating summary, review list, submission form, helpful "
"votes, and owner replies."
msgstr ""
"Exibe avaliações com resumo de classificação, lista de avaliações, "
"formulário de envio, votos úteis e respostas do proprietário."

#: blocks/listing-search/block.json
msgctxt "block description"
msgid ""
"Search form with filters, keyword, location, and type selector for "
"directory listings."
msgstr ""
"Formulário de busca com filtros, palavra-chave, localização e seletor de "
"tipo para anúncios de diretório."

#: blocks/listing-submission/block.json
msgctxt "block description"
msgid ""
"Multi-step frontend listing submission form with type-driven fields, media "
"upload, and preview."
msgstr ""
"Formulário de envio de anúncio com múltiplas etapas, campos orientados por "
"tipo, upload de mídia e visualização."

#: blocks/user-dashboard/block.json
msgctxt "block description"
msgid ""
"Frontend dashboard for listing owners — manage listings, reviews, "
"favorites, and profile."
msgstr ""
"Painel de controle de frontend para proprietários de anúncios — gerenciar "
"anúncios, avaliações, favoritos e perfil."

