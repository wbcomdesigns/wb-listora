#: blocks/listing-calendar/block.json
msgctxt "block description"
msgid "Month calendar view showing event listings by date."
msgstr "Vista de calendario mensual que muestra anuncios de eventos por fecha."

#: blocks/listing-card/block.json
msgctxt "block description"
msgid ""
"Displays a single listing as a card with image, rating, meta fields, and "
"favorite button."
msgstr ""
"Muestra un anuncio único como una tarjeta con imagen, calificación, campos "
"meta y botón de favorito."

#: blocks/listing-categories/block.json
msgctxt "block description"
msgid "Display listing categories in a grid with icons and listing counts."
msgstr ""
"Muestra categorías de anuncios en una cuadrícula con iconos y recuentos de "
"anuncios."

#: blocks/listing-detail/block.json
msgctxt "block description"
msgid ""
"Displays full listing details with gallery, tabs, contact info, business "
"hours, and reviews."
msgstr ""
"Muestra detalles completos del anuncio con galería, pestañas, información "
"de contacto, horarios comerciales y reseñas."

#: blocks/listing-featured/block.json
msgctxt "block description"
msgid "Display featured or top-rated listings in a horizontal carousel."
msgstr "Muestra anuncios destacados o mejor valorados en un carrusel horizontal."

#: blocks/listing-grid/block.json
msgctxt "block description"
msgid ""
"Displays listing search results in a responsive grid, list, or split view "
"with pagination."
msgstr ""
"Muestra resultados de búsqueda de anuncios en una vista de cuadrícula "
"receptiva, lista o vista dividida con paginación."

#: blocks/listing-map/block.json
msgctxt "block description"
msgid ""
"Interactive map showing listing locations with markers, clustering, and "
"search integration."
msgstr ""
"Mapa interactivo que muestra ubicaciones de anuncios con marcadores, "
"agrupación e integración de búsqueda."

#: blocks/listing-reviews/block.json
msgctxt "block description"
msgid ""
"Displays reviews with rating summary, review list, submission form, helpful "
"votes, and owner replies."
msgstr ""
"Muestra reseñas con resumen de calificación, lista de reseñas, formulario "
"de envío, votos útiles y respuestas del propietario."

#: blocks/listing-search/block.json
msgctxt "block description"
msgid ""
"Search form with filters, keyword, location, and type selector for "
"directory listings."
msgstr ""
"Formulario de búsqueda con filtros, palabra clave, ubicación y selector de "
"tipo para anuncios de directorio."

#: blocks/listing-submission/block.json
msgctxt "block description"
msgid ""
"Multi-step frontend listing submission form with type-driven fields, media "
"upload, and preview."
msgstr ""
"Formulario de envío de anuncio de múltiples pasos con campos basados en "
"tipo, carga de medios y vista previa."

#: blocks/user-dashboard/block.json
msgctxt "block description"
msgid ""
"Frontend dashboard for listing owners — manage listings, reviews, "
"favorites, and profile."
msgstr ""
"Panel frontal para propietarios de anuncios — gestiona anuncios, reseñas, "
"favoritos y perfil."

