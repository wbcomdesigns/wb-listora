msgstr "— Не сопоставлено —"

#: includes/admin/class-settings-page.php:793
msgid "Edit page"
msgstr "Редактировать страницу"

#: includes/admin/class-settings-page.php:797
msgid "View page"
msgstr "Просмотреть страницу"

