#: build/blocks/listing-submission/index.js:1
#: build/blocks/user-dashboard/index.js:1
#: src/shared/components/TypographyControl.js:37
msgid "None"
msgstr "Geen"

#: includes/admin/class-settings-page.php:1289
msgid "Google reCAPTCHA v3"
msgstr "Google reCAPTCHA v3"

#: includes/admin/class-settings-page.php:1290
msgid "Cloudflare Turnstile"
msgstr "Cloudflare Turnstile"

#: includes/admin/class-settings-page.php:1292
msgid ""
"Protects submission and review forms from spam. Requires a site key and "
"secret from the selected provider."
msgstr ""
"Beschermt inzend- en beoordelingsformulieren tegen spam. Vereist een "
"sitesleutel en geheim van de geselecteerde provider."

#: includes/admin/class-settings-page.php:1296
msgid "CAPTCHA site key"
msgstr "CAPTCHA-sitesleutel"

#: includes/admin/class-settings-page.php:1299
msgid "Public site key from your CAPTCHA provider dashboard."
msgstr "Openbare sitesleutel van je CAPTCHA-provider-dashboard."

#: includes/admin/class-settings-page.php:1303
msgid "CAPTCHA secret key"
msgstr "CAPTCHA-geheime sleutel"

#: includes/admin/class-settings-page.php:1306
msgid "Private secret key used for server-side verification. Never share publicly."
msgstr ""
"Privégeheime sleutel gebruikt voor verificatie aan de serverzijde. Deel dit "
"nooit openbaar."

#: includes/admin/class-settings-page.php:1332
msgid "Sell more than credits"
msgstr "Meer verkopen dan credits"

#: includes/admin/class-settings-page.php:1333
msgid ""
"Pro adds pricing plans, coupons, credit packs, webhooks, and full "
"transaction history."
msgstr ""
"Pro voegt abonnementen, coupons, creditpakketten, webhooks en volledige "
"transactiegeschiedenis toe."

#: includes/admin/class-settings-page.php:1335
msgid "Flexible pricing plans (one-off + subscription)"
msgstr "Flexibele abonnementen (eenmalig + abonnement)"

#: includes/admin/class-settings-page.php:1336
msgid "Coupon codes with expiry and usage limits"
msgstr "Couponcode's met vervaldatum en gebruikslimieten"

#: includes/admin/class-settings-page.php:1337
msgid "WooCommerce, PMPro, MemberPress adapters"
msgstr "WooCommerce, PMPro, MemberPress-adapters"

#: includes/admin/class-settings-page.php:1338
msgid "Transaction log + refund tooling"
msgstr "Transactielogboek + terugbetalingstools"

#: includes/admin/class-settings-page.php:1346
msgid "7 days"
msgstr "7 dagen"

#: includes/admin/class-settings-page.php:1347
#: includes/workflow/class-notifications.php:63
msgid "30 days"
msgstr "30 dagen"

#: includes/admin/class-settings-page.php:1348
msgid "90 days"
msgstr "90 dagen"

#: includes/admin/class-settings-page.php:1349
msgid "365 days"
msgstr "365 dagen"

#: includes/admin/class-settings-page.php:1350
msgid "Permanent (no expiration)"
msgstr "Permanent (geen vervaldatum)"

#: includes/admin/class-settings-page.php:1371
msgid "Credit Costs"
msgstr "Creditkosten"

#: includes/admin/class-settings-page.php:1372
msgid ""
"Credits charged for submitting listings and upgrading them to Featured. Set "
"any cost to 0 to make that action free."
msgstr ""
"Credits berekend voor het indienen van aanbiedingen en het upgraden ervan "
"naar uitgelicht. Stel elke kost op 0 in om die actie gratis te maken."

#: includes/admin/class-settings-page.php:1377
msgid "Listing submission cost"
msgstr "Kosten voor aanbiedingsinzending"

#: includes/admin/class-settings-page.php:1389
msgid ""
"Charged when submitting a standard listing without a paid plan. Set to 0 "
"for free submissions."
msgstr ""
"Berekend bij inzending van een standaardaanbieding zonder betaald "
"abonnement. Stel op 0 in voor gratis inzendingen."

#: includes/admin/class-settings-page.php:1393
msgid "Featured upgrade cost"
msgstr "Kosten voor upgrade naar uitgelicht"

#: includes/admin/class-settings-page.php:1405
msgid ""
"Charged when a user upgrades an existing listing to Featured. Set to 0 to "
"make upgrades free."
msgstr ""
"Berekend wanneer een gebruiker een bestaande aanbieding upgradet naar "
"uitgelicht. Stel op 0 in om upgrades gratis te maken."

#: includes/admin/class-settings-page.php:1409
msgid "Featured duration"
msgstr "Duur van uitgelicht"

#: includes/admin/class-settings-page.php:1424
msgid "Featured duration presets"
msgstr "Vooraf ingestelde duur voor uitgelicht"

#: includes/admin/class-settings-page.php:1427
msgid "Preset…"
msgstr "Voorinstelling…"

#: includes/admin/class-settings-page.php:1434
msgid ""
"How long a listing stays featured after upgrade. Set to 0 for permanent (no "
"expiration)."
msgstr ""
"Hoe lang een aanbieding uitgelicht blijft na upgrade. Stel op 0 in voor "
"permanent (geen vervaldatum)."

#: includes/admin/class-settings-page.php:1445
msgid "Payment Webhook"
msgstr "Betalingswebhook"

#: includes/admin/class-settings-page.php:1446
msgid ""
"Endpoint your payment provider POSTs to when a customer completes a "
"purchase. Listora verifies the HMAC signature, credits the matching user, "
"and writes a transaction ledger row."
msgstr ""
"Eindpunt waarop je betalingsprovider POSTs wanneer een klant een aankoop "
"voltooit. Listora verifieert de HMAC-handtekening, crediteert de "
"overeenkomstige gebruiker en schrijft een transactieboekentry."

#: includes/admin/class-settings-page.php:1451
msgid "Low Balance Alert"
msgstr "Waarschuwing laag saldo"

#: includes/admin/class-settings-page.php:1463
msgid ""
"Email the user when their credit balance drops below this amount. Set to 0 "
"to disable."
msgstr ""
"E-mail de gebruiker wanneer hun creditsaldo onder dit bedrag daalt. Stel op "
"0 in om uit te schakelen."

#: includes/admin/class-settings-page.php:1468
msgid "Webhook URL"
msgstr "Webhook URL"

#: includes/admin/class-settings-page.php:1474
#: includes/admin/class-settings-page.php:1488
msgid "Copy"
msgstr "Kopiëren"

#: includes/admin/class-settings-page.php:1477
msgid ""
"Paste this URL into your payment provider as the webhook destination. See "
"the integration guide below for per-provider setup steps."
msgstr ""
"Plak deze URL in je betalingsprovider als webhookbestemming. Zie "
"onderstaande integratiegids voor instellingsstappen per provider."

#: includes/admin/class-settings-page.php:1482
msgid "Webhook Secret"
msgstr "Webhook-geheim"

#: includes/admin/class-settings-page.php:1491
msgid ""
"Shared secret used to verify incoming webhook requests. Keep this value "
"private."
msgstr ""
"Gedeeld geheim gebruikt om inkomende webhook-verzoeken te verifiëren. Houd "
"deze waarde privé."

#: includes/admin/class-settings-page.php:1501
msgid "How to wire this up (Stripe, PayPal, WooCommerce, custom)"
msgstr "Hoe je dit instelt (Stripe, PayPal, WooCommerce, aangepast)"

#: includes/admin/class-settings-page.php:1504
msgid "Request contract"
msgstr "Verzoekcontract"

#: includes/admin/class-settings-page.php:1505
msgid ""
"Your provider (or a small relay you control) sends a signed POST to the "
"Webhook URL above. Listora rejects anything missing the headers below."
msgstr ""
"Je provider (of een kleine relay die je beheert) stuurt een ondertekende "
"POST naar de bovenstaande Webhook URL. Listora verwerpt alles waaraan de "
"onderstaande headers ontbreken."

#: includes/admin/class-settings-page.php:1509
msgid "Header"
msgstr "Header"

#: includes/admin/class-settings-page.php:1510
msgid "Value"
