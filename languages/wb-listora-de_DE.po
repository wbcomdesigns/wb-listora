#: includes/admin/class-credits-settings-tab.php:268
msgid "View Transaction Log"
msgstr "Transaktionsprotokoll anzeigen"

#: includes/admin/class-credits-settings-tab.php:265
msgid "Per-user credit ledger with filters and CSV export."
msgstr "Credit-Ledger pro Benutzer mit Filtern und CSV-Export."

