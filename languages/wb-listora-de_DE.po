msgstr ""
"Zoom-Stufe 1 (Welt) bis 20 (Straße). Stadtansichten verwenden "
"typischerweise 12–14."

#: includes/admin/class-settings-page.php:1108
msgid "Options"
msgstr "Optionen"

#: includes/admin/class-settings-page.php:1109
