msgstr ""
"Wenn deaktiviert, bleiben Reviews auf „Ausstehend“, bis ein Administrator "
"sie genehmigt."

#: includes/admin/class-settings-page.php:1229
msgid "Minimum length"
msgstr "Mindestlänge"

#: includes/admin/class-settings-page.php:1232
msgid "characters"
msgstr "Zeichen"

#: includes/admin/class-settings-page.php:1233
msgid ""
"Minimum characters required for the review body. Set to 0 to allow ratings "
