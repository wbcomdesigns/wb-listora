msgstr "Die Quellenangabe, die dein Anbieter auf der Karte anzeigen lässt."

#: includes/admin/class-map-settings-tab.php:126
msgid "Where maps start"
msgstr "Wo Karten starten"

#: includes/admin/class-map-settings-tab.php:127
