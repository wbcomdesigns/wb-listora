"ausgeblendet. Links, die Mitglieder bereits gespeichert haben, werden "
"beibehalten, nur nicht angezeigt."

#: includes/admin/class-settings-page.php:1161
msgid "Platforms"
msgstr "Plattformen"

#: includes/admin/class-settings-page.php:1164
msgid "Platforms offered on the Social Links field"
msgstr "Plattformen, die im Social-Links-Feld angeboten werden"

#: includes/admin/class-settings-page.php:1183
