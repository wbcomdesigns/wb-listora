node_modules/
# vendor/ is ignored, with ONE deliberate exception already committed:
# vendor/woocommerce/action-scheduler (101 files). Free bundles Action Scheduler
# and Pro consumes Free's copy at runtime, so a plain checkout must ship it - the
# same reason build/ is committed in both plugins. Do not `git rm -r --cached vendor`.
vendor/
!assets/vendor/
!assets/js/vendor/
.DS_Store
*.log
.phpunit.result.cache
dist/
.claude-tmp/

# QA journey run outputs (machine-generated, regenerated on every run)
docs/qa/journey-runs/

# Subagent-driven-development scratch workspace (ledger, briefs, review packages).
