    { "locale": "pt_BR", "name": "Brazilian Portuguese","register": "neutral (você)" },
    { "locale": "nl_NL", "name": "Dutch",               "register": "informal (je)" },
    { "locale": "ru_RU", "name": "Russian",             "register": "polite (вы)" },
    { "locale": "ja",    "name": "Japanese",            "register": "polite (ですます調)", "model": "sonnet" },
    { "locale": "pl_PL", "name": "Polish",              "register": "formal/impersonal" },
