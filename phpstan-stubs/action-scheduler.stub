<?php
/**
 * PHPStan stubs for Action Scheduler.
 *
 * Action Scheduler is bundled by Pro / WooCommerce / etc. and only loaded
 * at runtime when those plugins activate. The Cron_Scheduler abstraction
 * checks `function_exists()` before calling — so PHPStan needs to know
 * the function signatures even when AS isn't on the analyse path.
 */

/**
 * Schedule a recurring action.
 *
 * @param int    $timestamp        Unix timestamp of the first run.
 * @param int    $interval_seconds Recurrence interval in seconds.
 * @param string $hook             Hook name to fire.
 * @param array<int|string, mixed> $args Arguments passed to the hook.
 * @param string $group            Action Scheduler group.
 * @return int The action ID.
 */
function as_schedule_recurring_action( int $timestamp, int $interval_seconds, string $hook, array $args = array(), string $group = '' ): int {}

/**
 * Get the next scheduled time for an action.
 *
 * @param string                  $hook  Hook name.
 * @param array<int|string,mixed> $args  Arguments to match.
 * @param string                  $group Action Scheduler group.
 * @return int|bool Unix timestamp or false if no scheduled action found.
 */
function as_next_scheduled_action( string $hook, array $args = null, string $group = '' ) {}

/**
 * Unschedule all matching actions.
 *
 * @param string                  $hook  Hook name.
 * @param array<int|string,mixed> $args  Arguments to match.
 * @param string                  $group Action Scheduler group.
 * @return int Number of actions unscheduled.
 */
function as_unschedule_all_actions( string $hook = '', array $args = array(), string $group = '' ): int {}
