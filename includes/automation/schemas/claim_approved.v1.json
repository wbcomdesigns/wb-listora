{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"title": "claim_approved",
	"description": "A claim was approved and listing ownership transferred to the claimant.",
	"type": "object",
	"required": ["claim"],
	"properties": {
		"claim": {
			"type": "object",
			"description": "Canonical claim, identical to what GET /claims returns per row.",
			"required": ["id", "listing_id", "user_id", "status"],
			"properties": {
				"id": { "type": "integer" },
				"listing_id": { "type": "integer" },
				"listing_title": { "type": "string" },
				"listing_url": { "type": "string", "format": "uri" },
				"user_id": { "type": "integer" },
				"user_name": { "type": "string" },
				"user_email": { "type": "string" },
				"status": { "type": "string" },
				"admin_notes": { "type": "string" },
				"created_at": { "type": "string" }
			}
		}
	}
}
