{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"title": "favorite_removed",
	"description": "A member removed a listing from their favorites.",
	"type": "object",
	"required": ["listing", "user"],
	"properties": {
		"listing": {
			"type": "object",
			"description": "Canonical listing card, identical to what GET /listings returns.",
			"required": ["id", "title", "link"],
			"properties": {
				"id": { "type": "integer" },
				"title": { "type": "string" },
				"link": { "type": "string", "format": "uri" },
				"excerpt": { "type": "string" },
				"featured_image": { "type": ["object", "null"] },
				"rating": { "type": "object" }
			}
		},
		"user": {
			"type": "object",
			"description": "Canonical user, allow-listed fields only. Matches Payload::user().",
			"required": ["id", "display_name", "email"],
			"properties": {
				"id": { "type": "integer" },
				"display_name": { "type": "string" },
				"email": { "type": "string" },
				"registered": { "type": "string" }
			}
		}
	}
}
