includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 7
    paths:
        - wb-listora.php
        - includes
        - blocks
        - uninstall.php
    bootstrapFiles:
        - phpstan-bootstrap.php
        - vendor/autoload.php
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        # Real SDK class (bundled in libs/) - stubFiles cannot DECLARE unknown
        # classes, so blocks/ calling \Wbcom\Credits\Credits needs the real file.
        - libs/wbcom-credits-sdk/src/Credits.php
        # Same reason: the ledger-repair CLI converts minor<->major units
        # through \Wbcom\Credits\Money.
        - libs/wbcom-credits-sdk/src/Money.php
        # WooCommerce is an optional integration and is not installed for
        # analysis. Same reason as above: these symbols are UNKNOWN to
        # PHPStan, so they must be declared via scanFiles -- stubFiles can
        # only annotate symbols it already knows about.
        - phpstan-stubs/woocommerce.stub
    stubFiles:
        - phpstan-stubs/wbcom-credits.stub
        - phpstan-stubs/wp-script-modules.stub
        - phpstan-stubs/action-scheduler.stub
        - phpstan-stubs/demo-seeder.stub
    excludePaths:
        analyseAndScan:
            - vendor/ (?)
            - node_modules/ (?)
            - build/ (?)
            - tests/ (?)
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Function apply_filters invoked with#'
        - '#Function do_action invoked with#'
        - '#Variable \$\w+ might not be defined#'
        - '#Cannot access offset .* on mixed#'
        # The credits SDK is scanned via scanFiles, so PHPStan treats
        # method_exists() on it as always true. At RUNTIME the bundled SDK
        # version varies, and that guard is what keeps an older bundle from
        # fatalling. Analyser certainty here is an artifact of scanning the
        # current copy, not a property of every install.
        - '#Call to function method_exists\(\) with .*Wbcom.*Credits.* will always evaluate to true#'
